   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df = pd.read_csv(\"../data/processed/downloads.csv\")\n",
    "\n",
    "top = df.sort_values(\"downloads\", ascending=False).head(10)\n",
    "\n",
    "plt.barh(top[\"title\"], top[\"downloads\"])\n",
    "plt.xlabel(\"Downloads\")\n",
    "plt.title(\"Top 10 Gutenberg Books\")\n",
    "plt.show()\n"
   ]
  }
